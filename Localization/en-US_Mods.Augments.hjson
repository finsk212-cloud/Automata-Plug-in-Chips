Items: {
	AugmentEssenceItem: {
		DisplayName: Machine Core
		Tooltip: A pulsing power unit salvaged from machines, traded with Mistress 2B to acquire and re-forge Plugins.
	}

	SealedChipCacheItem: {
		DisplayName: Sealed Plugin Cache
		Tooltip:
			'''
			Encrypted YoRHa combat salvage pod
			Right-click to decrypt and choose 1 of 3 Plugins
			Plugin tier scales with your world's boss progression
			'''
	}

	MediGunItem: {
		DisplayName: Medi Gun MK I
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel a healing beam (3 HP/sec)
			Hold Right-Click to lock onto the nearest enemy and channel a crimson siphon beam ([c/FF5C5C:6 DMG/sec])
			Healing or siphoning builds Overclock charge over [c/A5C8E8:35 seconds]
			Press Right-Click at 100% while healing to activate Overclock:
			- Instantly restores [c/4ADE80:30 HP] to the tethered ally
			- Grants the ally [c/2DD4BF:+20% movement speed] for [c/A5C8E8:6 seconds]
			Press Left-Click at 100% while siphoning an enemy to detonate Overclock:
			- Deals [c/FF5C5C:25 burst damage] and inflicts [c/FFA500:Corrosion] (-5 enemy defense for 5s)
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK2Item: {
		DisplayName: Medi Gun MK II
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel an advanced healing beam (6 HP/sec)
			Hold Right-Click to lock onto the nearest enemy and channel a crimson siphon beam ([c/FF5C5C:20 DMG/sec])
			Healing or siphoning builds Overclock charge over [c/A5C8E8:30 seconds]
			Press Right-Click at 100% while healing to activate Overclock:
			- Instantly restores [c/4ADE80:50 HP] to the tethered ally
			- Grants the ally [c/2DD4BF:+20% movement speed] and [c/FB923C:+10% attack speed] for [c/A5C8E8:6 seconds]
			Press Left-Click at 100% while siphoning an enemy to detonate Overclock:
			- Deals [c/FF5C5C:60 burst damage] and inflicts [c/EAB308:Ichor] (-15 enemy defense for 6s)
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK3Item: {
		DisplayName: Medi Gun MK III
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel an advanced spectral healing beam (10 HP/sec)
			Hold Right-Click to lock onto the nearest enemy and channel a crimson siphon beam ([c/FF5C5C:3x 20 DMG bursts every 1.5s])
			Healing or siphoning builds Overclock charge over [c/A5C8E8:25 seconds]
			Press Right-Click at 100% while healing to activate Overclock:
			- Instantly restores [c/4ADE80:75 HP] to the tethered ally
			- Grants the ally [c/2DD4BF:+25% movement speed], [c/FB923C:+15% attack speed], and [c/FFC83B:+8% critical strike chance] for [c/A5C8E8:6 seconds]
			Press Left-Click at 100% while siphoning an enemy to detonate Overclock:
			- Deals [c/FF5C5C:150 burst damage] and inflicts [c/EAB308:Ichor] (-15 enemy defense for 8s)
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK4Item: {
		DisplayName: Medi Gun MK IV
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel an ultimate celestial healing beam (16 HP/sec)
			Hold Right-Click to lock onto the nearest enemy and channel a crimson siphon beam ([c/FF5C5C:3x 50 DMG bursts every 1.5s])
			Healing or siphoning builds Overclock charge over [c/A5C8E8:20 seconds]
			Press Right-Click at 100% while healing to activate Overclock:
			- Instantly restores [c/4ADE80:100 HP] to the tethered ally
			- Grants the ally [c/2DD4BF:+30% movement speed], [c/FB923C:+20% attack speed], [c/FFC83B:+12% critical strike chance], and [c/FF5C5C:+15% all damage] for [c/A5C8E8:6 seconds]
			Press Left-Click at 100% while siphoning an enemy to detonate Overclock:
			- Deals [c/FF5C5C:300 burst damage] and inflicts [c/EAB308:Ichor] (-15 defense) & [c/D946EF:Betsy's Curse] (-40 defense) for 10s
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}
}

