Configs: {
	AugmentConfig: {
		DisplayName: Automata Configuration
		Headers.HiddenStatsSettings: Hidden Telemetry & Diagnostics Settings

		EnableHiddenStatsPanel: {
			Label: Enable Hidden Stats Drawer
			Tooltip: Shows an arrow tab on the edge of the screen that slides out a NieR-styled Hidden Diagnostics panel displaying Luck, Fishing multipliers, and Combat hidden mechanics.
		}

		DrawerOpenMode: {
			Label: Interaction Mode
			Tooltip: Choose between Click to toggle (prevents accidental opening in combat) or Hover to slide open.
		}

		DockOnRightSide: {
			Label: Dock On Right Screen Edge
			Tooltip: When enabled, docks the drawer tab on the right side of the screen instead of the left side.
		}

		Headers.AdvisorySettings: Pod 042 Advisory Tips

		EnableAdvisoryTips: {
			Label: Enable Advisory Tips
			Tooltip: Shows the automatic Pod 042 tips at the bottom of the screen (periodic hints and first-time tutorials). The TIP button and hotkey still work when this is off.
		}

		AdvisoryTipIntervalMinutes: {
			Label: Tip Interval (Minutes)
			Tooltip: How many minutes pass between automatic Pod 042 tips. Tips are paused during boss fights.
		}
	}

	AugmentServerConfig: {
		DisplayName: Automata Server Configuration

		EnableDeveloperTools: {
			Label: Enable Developer Tools
			Tooltip: Turns on the /augment command, the dev-mode chip editor and the dev keybinds (spawn vendor, trigger reward, reset cooldowns). Leave OFF on public servers - anyone could grant themselves chips.
		}
	}

	TelemetryOpenMode: {
		Tooltip: ""

		ClickToToggle: {
			Label: Click To Toggle
			Tooltip: ""
		}

		HoverToOpen: {
			Label: Hover To Open
			Tooltip: ""
		}
	}
}
